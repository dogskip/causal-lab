{
  "name": "causal-lab",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Reproducible CRDT verification, independent checks and replayable failure files",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "causal-lab": "./dist/server.js",
    "causal-lab-verify": "./dist/verify-cli.js"
  },
  "files": [
    "dist",
    "schema",
    "examples",
    "pnpm-lock.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:site": "vite build",
    "dev:web": "vite",
    "test": "vitest run",
    "test:deep": "CAUSAL_LAB_PROPERTY_RUNS=5000 vitest run test/property.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "start": "tsx src/server.ts",
    "bench": "tsx bench/bench.ts",
    "repl": "tsx src/repl.ts",
    "verify": "tsx src/verify-cli.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@hono/node-server": "2.0.10",
    "fast-check": "3.23.2",
    "hono": "4.13.7",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.13",
    "ajv": "8.17.1",
    "eslint": "10.7.0",
    "mermaid": "11.12.3",
    "prettier": "3.6.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "types": "./dist/index.d.ts"
}
