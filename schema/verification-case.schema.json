{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causal-lab.dev/schema/verification-case.schema.json",
  "title": "VerificationCase v2",
  "description": "Structural assertions. The runtime additionally checks exact membership, chronological order, UTF-8 size, duplicate keys, valid Unicode, depth and registered capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "model_id",
    "profile",
    "replicas",
    "bootstrap",
    "seed",
    "network",
    "steps",
    "checks"
  ],
  "properties": {
    "format_version": {
      "const": 2
    },
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "profile": {
      "const": "independent-updates"
    },
    "replicas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,128}$"
      }
    },
    "bootstrap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,128}$"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minLatency",
        "maxLatency",
        "dropRate",
        "duplicateRate"
      ],
      "properties": {
        "minLatency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "maxLatency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "dropRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duplicateRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "action"
            ],
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "action": {
                "const": "heal"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "action",
              "left",
              "right"
            ],
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "action": {
                "const": "partition"
              },
              "left": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,128}$"
              },
              "right": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,128}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "action",
              "replica",
              "command"
            ],
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "action": {
                "const": "command"
              },
              "replica": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,128}$"
              },
              "command": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,128}$"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "parameters": {}
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "const": "convergence"
          }
        }
      }
    }
  }
}
